PORT=5000
# Local MongoDB, or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/cxr-rrg
# AI service: local ml/server.py (or the Modal URL in production)
ML_PROXY_TARGET=http://127.0.0.1:8000
# Shared secret sent to the AI service (must match the Modal secret "cxr-ml-key"); empty locally
ML_API_KEY=
# Optional: "Sign in with Google" (OAuth client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=
# Optional doctor account that can see every user's reports
DOCTOR_EMAIL=doctor@example.com
DOCTOR_PASSWORD=change-me-to-a-long-password
